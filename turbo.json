{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "COOKIE_SECRET",
    "AUTH_MFA_ENCRYPTION_KEY",
    "SANITY_SYNC_SECRET_TOKEN",
    "SANITY_API_READ_TOKEN",
    "NEXT_PUBLIC_SANITY_PROJECT_ID",
    "NEXT_PUBLIC_SANITY_DATASET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "out/**", ".medusa/server/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },

    "typecheck": {
      "cache": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "seed": {
      "outputs": []
    },
    "predeploy":{
      "dependsOn": ["^build"],
      "cache": false
      

    },

    "db:migrate": {
      "cache": false
    },
    "test:unit": { "cache": true },
    "test:integration": { 
      "cache": false
    },
    "test:proxy": { 
      "cache": false
    },
    "test:sync:e2e": {
      "cache": false
    },
    
    "ci:sync:e2e": {
        "cache": false
    }
    
  }
}
