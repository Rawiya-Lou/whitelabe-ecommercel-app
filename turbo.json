{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalPassThroughEnv": ["CI", "SKIP_ENV_VALIDATION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test*"]
    },
    "test:unit": {
      "outputs": []
    },
    "test:integration": {
      "cache": false
    },
    "test:proxy": {
      "cache": false
    },
    "test:sync:e2e": {
      "cache": false
    },
    "ci:sync:e2e": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "predeploy": {
      "dependsOn": ["^build"],
      "cache": false,
      "interactive": true
    }
  }
}
