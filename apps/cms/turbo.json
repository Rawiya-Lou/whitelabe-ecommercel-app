{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"],
      "outputs": ["dist/**"],
      "env": [
        "SANITY_STUDIO_*",
        "SANITY_PROJECT_ID",
        "PROJECT_ID",
        "SANITY_DATASET",
        "SANITY_API_TOKEN",
        "STOREFRONT_URL",
        "PREVIEW_SECRET"

      ]
    }
  }
}
