{
  "name": "whitelabel-ecommerce-site",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "migrate": "turbo db:migrate --filter=@dtc/backend",
    "predeploy": "turbo predeploy --filter=@dtc/backend",
    "test:proxy": "turbo run test:proxy --filter=storefront",
    "test:unit": "turbo run test:unit --filter=storefront",
    "test:integration": "turbo run test:integration --filter=storefront",
    "test:sync:e2e": "turbo run test:sync:e2e --filter=@dtc/backend",
    "ci:sync:e2e": "turbo run ci:sync:e2e --filter=@dtc/backend",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=storefront",
    "cms:dev": "turbo dev --filter=cms"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.22.7",
    "@medusajs/eslint-plugin": "^2.22.7",
    "@medusajs/medusa": "2.22.7",
    "@medusajs/ui": "^4.2.14",
    "ajv": "^8.13.0",
    "eslint": "^9.39.4",
    "eslint-config-turbo": "^2.11.11",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**",
    "!apps/backend/public/admin"
  ],
  "overrides": {
    "@sanity/icons": "^5.3.0",
    "@medusajs/medusa": {
      "react": "^18.3.1 || ^19.0.0",
      "react-dom": "^18.3.1 || ^19.0.0"
    },
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
